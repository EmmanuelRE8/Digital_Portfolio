---
import DynamicKPIs from './DynamicKPIs.jsx';
import { NODES } from '../data/nodes.js';
---

<section class="hub-container">
  <header class="hub-header">
    <p class="hub-eyebrow">// space: system online</p>
    <h1>Emmanuel's Neural Network</h1>
    <p>Navigate through connected nodes. Each one holds a different part of my story.</p>
  </header>

  <DynamicKPIs client:load />

  <nav class="hub-grid" aria-label="Nodes">
    {NODES.map((node) => {
      const Tag = node.href ? 'a' : 'div';
      return (
        <Tag
          href={node.href ?? undefined}
          class:list={['cuarto-card', { 'cuarto-card--locked': !node.href }]}
          aria-disabled={node.href ? undefined : 'true'}
        >
          <span class="cuarto-icon" aria-hidden="true">{node.icon}</span>
          <span class="node-id">Node {node.id}</span>
          <h2>{node.name}</h2>
          <p>"{node.tagline}"</p>
          {node.badge && <span class="cuarto-badge">{node.badge}</span>}
        </Tag>
      );
    })}
  </nav>

  <div class="hub-actions">
    <a href="/comms#cv" class="hub-btn hub-btn--primary">CV</a>
    <a href="/neural-core" class="hub-btn">Mr Code</a>
    <a href="/comms" class="hub-btn">Contact</a>
  </div>
</section>
