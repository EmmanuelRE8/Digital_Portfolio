---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Skills">
  <main>
    <section class="skills-hero">
      <div class="container">
        <h1>Skills & Expertise</h1>
        <p>A comprehensive overview of my technical capabilities and professional competencies.</p>
      </div>
    </section>

    <!-- Core Competencies -->
    <section class="skills-core">
      <div class="container">
        <h2>Core Competencies</h2>
        
        <div class="competencies-grid">
          <div class="competency">
            <h3>📊 Analytics & BI</h3>
            <p>Building dashboards, designing metrics, and creating analytics frameworks that drive business decisions.</p>
            <div class="skills-list">
              <span class="skill">Tableau</span>
              <span class="skill">Looker Studio</span>
              <span class="skill">GA4 Analytics</span>
              <span class="skill">Funnel Analysis</span>
              <span class="skill">Cohort Analysis</span>
              <span class="skill">Churn Prediction</span>
            </div>
          </div>

          <div class="competency">
            <h3>🗄️ Data Engineering</h3>
            <p>Designing data pipelines, ensuring data quality, and building scalable data infrastructure.</p>
            <div class="skills-list">
              <span class="skill">BigQuery</span>
              <span class="skill">Databricks</span>
              <span class="skill">PySpark</span>
              <span class="skill">ETL Pipelines</span>
              <span class="skill">Data Warehousing</span>
              <span class="skill">SQL Optimization</span>
            </div>
          </div>

          <div class="competency">
            <h3>🤖 AI & Machine Learning</h3>
            <p>Building predictive models, NLP systems, and intelligent algorithms for business applications.</p>
            <div class="skills-list">
              <span class="skill">Python (pandas, NumPy)</span>
              <span class="skill">Scikit-learn</span>
              <span class="skill">TensorFlow & Keras</span>
              <span class="skill">NLP & Embeddings</span>
              <span class="skill">Forecasting (ARIMA, Prophet)</span>
              <span class="skill">Recommendation Systems</span>
            </div>
          </div>

          <div class="competency">
            <h3>📈 Business Analytics</h3>
            <p>Translating data into actionable insights for pricing, marketing, and revenue optimization.</p>
            <div class="skills-list">
              <span class="skill">Pricing Elasticity</span>
              <span class="skill">RFM Segmentation</span>
              <span class="skill">CLV Modeling</span>
              <span class="skill">Forecasting</span>
              <span class="skill">A/B Testing</span>
              <span class="skill">Revenue Analytics</span>
            </div>
          </div>

          <div class="competency">
            <h3>🧠 Leadership & Strategy</h3>
            <p>Building teams, designing analytics strategies, and driving organizational change through data.</p>
            <div class="skills-list">
              <span class="skill">BI Team Leadership</span>
              <span class="skill">Analytics Strategy</span>
              <span class="skill">Stakeholder Management</span>
              <span class="skill">Process Design</span>
              <span class="skill">Data Governance</span>
              <span class="skill">Change Management</span>
            </div>
          </div>

          <div class="competency">
            <h3>🎨 Data Visualization & Storytelling</h3>
            <p>Creating compelling data narratives that communicate insights and drive decision-making.</p>
            <div class="skills-list">
              <span class="skill">Data Visualization Design</span>
              <span class="skill">Infographics</span>
              <span class="skill">Scrollytelling</span>
              <span class="skill">Tableau Dashboards</span>
              <span class="skill">Presentation Skills</span>
              <span class="skill">Data Comics</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Stack by Category -->
    <section class="tech-stack-detailed">
      <div class="container">
        <h2>Technical Stack</h2>
        
        <!-- Languages -->
        <div class="stack-category">
          <h3>Programming Languages</h3>
          <div class="stack-items">
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 95%"></span>
              </span>
              <p><strong>Python</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 90%"></span>
              </span>
              <p><strong>SQL</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 75%"></span>
              </span>
              <p><strong>JavaScript</strong> — Intermediate</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 70%"></span>
              </span>
              <p><strong>PySpark</strong> — Intermediate</p>
            </div>
          </div>
        </div>

        <!-- Data Platforms -->
        <div class="stack-category">
          <h3>Data Platforms & Tools</h3>
          <div class="stack-items">
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 95%"></span>
              </span>
              <p><strong>BigQuery</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 90%"></span>
              </span>
              <p><strong>Databricks</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 85%"></span>
              </span>
              <p><strong>Tableau</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 85%"></span>
              </span>
              <p><strong>Looker Studio</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 80%"></span>
              </span>
              <p><strong>Google Analytics 4</strong> — Intermediate</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 75%"></span>
              </span>
              <p><strong>Smartsheet</strong> — Intermediate</p>
            </div>
          </div>
        </div>

        <!-- ML & AI -->
        <div class="stack-category">
          <h3>Machine Learning & AI</h3>
          <div class="stack-items">
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 85%"></span>
              </span>
              <p><strong>Scikit-learn</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 80%"></span>
              </span>
              <p><strong>TensorFlow & Keras</strong> — Intermediate</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 85%"></span>
              </span>
              <p><strong>NLP & Embeddings</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 80%"></span>
              </span>
              <p><strong>Time Series Forecasting</strong> — Intermediate</p>
            </div>
          </div>
        </div>

        <!-- Cloud & Infrastructure -->
        <div class="stack-category">
          <h3>Cloud & Infrastructure</h3>
          <div class="stack-items">
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 90%"></span>
              </span>
              <p><strong>Google Cloud Platform</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 65%"></span>
              </span>
              <p><strong>AWS (S3, basics)</strong> — Beginner</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 85%"></span>
              </span>
              <p><strong>Git & GitHub</strong> — Advanced</p>
            </div>
            <div class="stack-item">
              <span class="proficiency-bar">
                <span class="bar-fill" style="width: 80%"></span>
              </span>
              <p><strong>Jupyter Notebooks</strong> — Advanced</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Methodologies & Frameworks -->
    <section class="methodologies">
      <div class="container">
        <h2>Methodologies & Frameworks</h2>
        
        <div class="methodology-grid">
          <div class="methodology-card">
            <h3>Experimentation & A/B Testing</h3>
            <p>Designing, executing, and analyzing experiments to validate hypotheses and optimize product decisions.</p>
          </div>
          <div class="methodology-card">
            <h3>Statistical Analysis</h3>
            <p>Rigorous statistical methods including hypothesis testing, regression, and causal inference.</p>
          </div>
          <div class="methodology-card">
            <h3>Data Storytelling</h3>
            <p>Translating complex analytical findings into compelling narratives that inspire action.</p>
          </div>
          <div class="methodology-card">
            <h3>Agile Analytics</h3>
            <p>Working in cross-functional teams with iterative delivery and rapid feedback cycles.</p>
          </div>
          <div class="methodology-card">
            <h3>Data Governance</h3>
            <p>Establishing frameworks for data quality, security, and compliance at organizational scale.</p>
          </div>
          <div class="methodology-card">
            <h3>Responsible AI</h3>
            <p>Implementing fairness, explainability, and transparency in machine learning systems.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Certifications & Learning -->
    <section class="learning">
      <div class="container">
        <h2>Continuous Learning</h2>
        <p>I'm committed to staying current with the rapidly evolving field of data analytics and AI.</p>
        
        <div class="learning-grid">
          <div class="learning-card">
            <h3>📚 Formal Education</h3>
            <ul>
              <li>MBAI in Business Analytics & AI (Ontario Tech University) — 2026</li>
              <li>Master's in Prospective Strategy (Tecnológico de Monterrey) — 2020</li>
              <li>Bachelor of Arts in International Relations (ITAM) — 2018</li>
            </ul>
          </div>

          <div class="learning-card">
            <h3>🎓 Specialized Coursework</h3>
            <ul>
              <li>Applied Integrative Analytics (Capstone: Semantic AI Framework)</li>
              <li>Data Visualization & Storytelling</li>
              <li>Machine Learning & Statistical Analysis</li>
              <li>Time Series Forecasting</li>
              <li>NLP & Advanced Python</li>
            </ul>
          </div>

          <div class="learning-card">
            <h3>🔍 Focus Areas</h3>
            <ul>
              <li>Applied AI & Machine Learning</li>
              <li>Data Engineering & Cloud Infrastructure</li>
              <li>Advanced Analytics & Experimentation</li>
              <li>Data Storytelling & Visualization</li>
              <li>Responsible AI & Ethics</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="skills-cta">
      <div class="container">
        <h2>Let's Work Together</h2>
        <p>If you're looking for a data analytics professional with deep technical skills and strategic thinking, I'd love to connect.</p>
        <div class="cta-buttons">
          <a href="mailto:emmanuel.ruedaescalona@ontariotechu.net" class="btn">Email Me</a>
          <a href="https://linkedin.com/in/emmanuelre" target="_blank" class="btn btn-secondary">LinkedIn</a>
          <a href="/projects" class="btn btn-secondary">View Projects</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .skills-hero {
    padding: 4rem 0;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.05) 0%, rgba(59, 130, 246, 0.05) 100%);
  }

  .skills-hero h1 {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  /* Core Competencies */
  .skills-core {
    padding: 6rem 0;
  }

  .skills-core h2 {
    margin-bottom: 3rem;
  }

  .competencies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .competency {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .competency:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.1);
    transform: translateY(-4px);
  }

  .competency h3 {
    margin-bottom: 1rem;
  }

  .competency p {
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill {
    display: inline-block;
    background: rgba(245, 158, 11, 0.1);
    color: var(--color-accent);
    padding: 0.4rem 0.8rem;
    border-radius: 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* Tech Stack Detailed -->
  .tech-stack-detailed {
    padding: 6rem 0;
    background: var(--color-bg-secondary);
  }

  .tech-stack-detailed h2 {
    margin-bottom: 3rem;
  }

  .stack-category {
    margin-bottom: 3rem;
  }

  .stack-category h3 {
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .stack-items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .stack-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stack-item p {
    font-size: 0.9rem;
    margin: 0;
  }

  .proficiency-bar {
    display: block;
    height: 6px;
    background: var(--color-border);
    border-radius: 3px;
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--color-accent), #3b82f6);
    border-radius: 3px;
  }

  /* Methodologies */
  .methodologies {
    padding: 6rem 0;
  }

  .methodologies h2 {
    margin-bottom: 3rem;
  }

  .methodology-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .methodology-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .methodology-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.1);
  }

  .methodology-card h3 {
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  /* Learning -->
  .learning {
    padding: 6rem 0;
    background: var(--color-bg-secondary);
  }

  .learning h2 {
    margin-bottom: 1rem;
  }

  .learning > .container > p {
    max-width: 600px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .learning-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .learning-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 2rem;
  }

  .learning-card h3 {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .learning-card ul {
    list-style: none;
    padding: 0;
  }

  .learning-card li {
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(100, 116, 139, 0.3);
    font-size: 0.9rem;
  }

  .learning-card li:last-child {
    border-bottom: none;
  }

  /* CTA -->
  .skills-cta {
    padding: 4rem 0;
    text-align: center;
    background: var(--color-bg-secondary);
  }

  .skills-cta h2 {
    margin-bottom: 1rem;
  }

  .skills-cta > .container > p {
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .competencies-grid {
      grid-template-columns: 1fr;
    }

    .stack-items {
      grid-template-columns: 1fr;
    }
  }
</style>
