---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
  <main>
    <section class="about-hero">
      <div class="container">
        <h1>About Me</h1>
        <p>A data-driven professional passionate about transforming insights into action.</p>
      </div>
    </section>

    <!-- Main About -->
    <section class="about-main">
      <div class="container">
        <div class="about-grid">
          <div class="about-text">
            <h2>Who I Am</h2>
            <p>
              I'm a Business Intelligence and Data Analytics leader with 5+ years of experience 
              building data-driven organizations and solving complex business problems through analytics, 
              strategic insights, and AI-powered solutions.
            </p>
            <p>
              My background spans three major roles—from early-stage ventures to scaling operations at 
              Ticketmaster—where I've led BI transformation, designed data governance frameworks, 
              and built analytics teams. I believe that great analytics is not about dashboards; 
              it's about clarity, trust, and impact.
            </p>
            <p>
              Currently based in Oshawa, Ontario, Canada on a Post-Graduation Work Permit (PGWP), 
              I'm actively exploring opportunities in Data Analytics, Business Intelligence, and 
              Data Science roles across Canada.
            </p>
          </div>

          <div class="about-highlights">
            <div class="highlight-card">
              <h3>5+</h3>
              <p>Years in Analytics & BI</p>
            </div>
            <div class="highlight-card">
              <h3>3</h3>
              <p>Companies</p>
            </div>
            <div class="highlight-card">
              <h3>2</h3>
              <p>Master's Degrees</p>
            </div>
            <div class="highlight-card">
              <h3>20+</h3>
              <p>Projects Delivered</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Professional Journey -->
    <section class="journey">
      <div class="container">
        <h2>Professional Journey</h2>
        
        <div class="timeline">
          <!-- Ticketmaster -->
          <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h3>Ticketmaster Mexico — BI Leader</h3>
              <p class="timeline-period">~3 years</p>
              <p>
                Led BI and Analytics for Mexico & LatAm markets. Built and scaled the BI team, 
                designed and implemented BEATS (BI request management system), led data migration 
                from SQL Server to Databricks/BigQuery, and drove analytics strategy across product, 
                marketing, and revenue teams.
              </p>
              <ul>
                <li>Designed BEATS system: 2-day faster delivery, 80% → 98% effectiveness</li>
                <li>Cloud migration: data accuracy improved from 80% to 99%</li>
                <li>Pricing, customer, and revenue analytics frameworks</li>
                <li>Cross-functional leadership and stakeholder management</li>
              </ul>
            </div>
          </div>

          <!-- TOP Agency / Wisevoter -->
          <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h3>TOP Agency / Wisevoter — Senior Analyst</h3>
              <p class="timeline-period">~1.5 years</p>
              <p>
                Advanced analytics roles on political forecasting, campaign strategy, and data product development. 
                Led data infrastructure projects and mentored junior analysts in statistical analysis and ML.
              </p>
              <ul>
                <li>PySpark data pipelines and BigQuery infrastructure</li>
                <li>ML models for forecasting and segmentation</li>
                <li>Data infrastructure and governance</li>
                <li>Team leadership and mentorship</li>
              </ul>
            </div>
          </div>

          <!-- Cuadrante -->
          <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h3>Cuadrante — Analytics Associate</h3>
              <p class="timeline-period">~1 year</p>
              <p>
                Early-stage analytics role at a strategic consulting firm. Developed analytical frameworks 
                for client projects, built dashboards, and contributed to business development through data insights.
              </p>
              <ul>
                <li>Client-facing analytics and reporting</li>
                <li>Dashboard design and automation</li>
                <li>SQL and Python for data analysis</li>
                <li>Business development support</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="education">
      <div class="container">
        <h2>Education</h2>
        
        <div class="education-grid">
          <div class="education-card">
            <h3>MBAI in Business Analytics & AI</h3>
            <p class="school">Ontario Tech University</p>
            <p class="details">Completed 2026</p>
            <p>
              Specialized in applied analytics, AI/ML, data visualization storytelling, 
              and strategic foresight. Capstone: Semantic AI Framework for contextual job matching.
            </p>
          </div>

          <div class="education-card">
            <h3>Master's in Prospective Strategy</h3>
            <p class="school">Tecnológico de Monterrey</p>
            <p class="details">Completed 2020</p>
            <p>
              Strategic foresight, scenario planning, and systems thinking. 
              Thesis: Costa Rica Higher-Education Foresight to 2050.
            </p>
          </div>

          <div class="education-card">
            <h3>Bachelor of Arts in International Relations</h3>
            <p class="school">ITAM (Instituto Tecnológico Autónomo de México)</p>
            <p class="details">Completed 2018</p>
            <p>
              Interdisciplinary foundation in political science, economics, and international systems. 
              Developed analytical and research skills early.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack in Detail -->
    <section class="tech-detailed">
      <div class="container">
        <h2>Technical Expertise</h2>
        
        <div class="tech-grid">
          <div class="tech-category">
            <h3>Analytics & BI</h3>
            <ul>
              <li>Tableau</li>
              <li>Looker Studio</li>
              <li>Google Analytics 4 (GA4)</li>
              <li>Funnel & Cohort Analysis</li>
              <li>Churn Prediction</li>
              <li>RFM & CLV Modeling</li>
            </ul>
          </div>

          <div class="tech-category">
            <h3>Data Platforms</h3>
            <ul>
              <li>BigQuery</li>
              <li>Databricks</li>
              <li>Smartsheet</li>
              <li>SQL Server</li>
              <li>Data Warehousing</li>
              <li>ETL & Data Pipelines</li>
            </ul>
          </div>

          <div class="tech-category">
            <h3>Programming</h3>
            <ul>
              <li>Python (pandas, NumPy, Matplotlib, Seaborn)</li>
              <li>SQL (complex queries, optimization)</li>
              <li>PySpark</li>
              <li>JavaScript</li>
              <li>Data structures & algorithms</li>
            </ul>
          </div>

          <div class="tech-category">
            <h3>Machine Learning & AI</h3>
            <ul>
              <li>Scikit-learn</li>
              <li>TensorFlow & Keras</li>
              <li>NLP & Embeddings (MiniLM)</li>
              <li>Supervised & unsupervised learning</li>
              <li>Time-series forecasting (ARIMA, Prophet)</li>
              <li>Recommendation systems</li>
            </ul>
          </div>

          <div class="tech-category">
            <h3>Cloud & DevOps</h3>
            <ul>
              <li>Google Cloud Platform (BigQuery, Dataflow)</li>
              <li>AWS (S3, basics)</li>
              <li>Version control (Git/GitHub)</li>
              <li>Jupyter Notebooks</li>
              <li>Box integration & API work</li>
            </ul>
          </div>

          <div class="tech-category">
            <h3>Analytics & Methodologies</h3>
            <ul>
              <li>Experimentation & A/B testing</li>
              <li>Statistical analysis</li>
              <li>Pricing elasticity</li>
              <li>Forecasting & modeling</li>
              <li>Data visualization & storytelling</li>
              <li>Responsible AI & fairness</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Languages & Location -->
    <section class="languages">
      <div class="container">
        <h2>Languages & Location</h2>
        
        <div class="language-grid">
          <div class="language-card">
            <h3>Languages</h3>
            <ul>
              <li><strong>Spanish</strong> — Native</li>
              <li><strong>English</strong> — Advanced (Professional)</li>
              <li><strong>Portuguese</strong> — Intermediate</li>
            </ul>
          </div>

          <div class="location-card">
            <h3>Location</h3>
            <p><strong>Oshawa, Ontario, Canada</strong></p>
            <p>Post-Graduation Work Permit (PGWP): 2026–2029</p>
            <p>Open to remote (Canada-wide) or hybrid/on-site in Greater Toronto Area.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="about-cta">
      <div class="container">
        <h2>Let's Talk</h2>
        <p>Interested in collaborating or learning more about my background? Reach out!</p>
        <div class="cta-buttons">
          <a href="mailto:emmanuel.ruedaescalona@ontariotechu.net" class="btn">Email Me</a>
          <a href="https://linkedin.com/in/emmanuelre" target="_blank" class="btn btn-secondary">LinkedIn</a>
          <a href="https://emmanuelre8.github.io/PAIR_Bot/" target="_blank" class="btn btn-secondary">PAIR Bot</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .about-hero {
    padding: 4rem 0;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.05) 0%, rgba(59, 130, 246, 0.05) 100%);
  }

  .about-hero h1 {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  /* About Main */
  .about-main {
    padding: 6rem 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .about-text p {
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .about-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .highlight-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    text-align: center;
  }

  .highlight-card h3 {
    font-size: 2.5rem;
    color: var(--color-accent);
    margin: 0;
  }

  .highlight-card p {
    margin: 0.5rem 0 0 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  /* Timeline */
  .journey {
    padding: 6rem 0;
    background: var(--color-bg-secondary);
  }

  .journey h2 {
    margin-bottom: 3rem;
  }

  .timeline {
    position: relative;
    padding: 2rem 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    padding-left: 3rem;
  }

  .timeline-marker {
    position: absolute;
    left: -8px;
    top: 0;
    width: 16px;
    height: 16px;
    background: var(--color-accent);
    border: 3px solid var(--color-bg-secondary);
    border-radius: 50%;
  }

  .timeline-content h3 {
    margin-bottom: 0.25rem;
  }

  .timeline-period {
    font-size: 0.875rem;
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .timeline-content p {
    margin-bottom: 1rem;
  }

  .timeline-content ul {
    list-style: none;
    padding: 0;
  }

  .timeline-content li {
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    position: relative;
    font-size: 0.95rem;
  }

  .timeline-content li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  /* Education */
  .education {
    padding: 6rem 0;
  }

  .education h2 {
    margin-bottom: 3rem;
  }

  .education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .education-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .education-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.1);
  }

  .education-card h3 {
    margin-bottom: 0.5rem;
  }

  .school {
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .details {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  /* Tech Detailed -->
  .tech-detailed {
    padding: 6rem 0;
    background: var(--color-bg-secondary);
  }

  .tech-detailed h2 {
    margin-bottom: 3rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .tech-category {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 2rem;
  }

  .tech-category h3 {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .tech-category ul {
    list-style: none;
    padding: 0;
  }

  .tech-category li {
    padding: 0.5rem 0;
    color: var(--color-text-secondary);
    border-bottom: 1px solid rgba(100, 116, 139, 0.3);
  }

  .tech-category li:last-child {
    border-bottom: none;
  }

  /* Languages -->
  .languages {
    padding: 6rem 0;
  }

  .languages h2 {
    margin-bottom: 3rem;
  }

  .language-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .language-card,
  .location-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 2rem;
  }

  .language-card h3,
  .location-card h3 {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .language-card ul {
    list-style: none;
    padding: 0;
  }

  .language-card li {
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(100, 116, 139, 0.3);
  }

  .language-card li:last-child {
    border-bottom: none;
  }

  .location-card p {
    margin-bottom: 0.75rem;
  }

  /* CTA -->
  .about-cta {
    padding: 4rem 0;
    text-align: center;
    background: var(--color-bg-secondary);
  }

  .about-cta h2 {
    margin-bottom: 1rem;
  }

  .about-cta > .container > p {
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-highlights {
      grid-template-columns: 1fr;
    }

    .timeline::before {
      left: -20px;
    }

    .timeline-marker {
      left: -26px;
    }

    .timeline-item {
      padding-left: 1.5rem;
    }
  }
</style>
