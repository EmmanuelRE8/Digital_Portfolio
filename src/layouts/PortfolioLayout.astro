---
import StarfieldBackground from '../components/StarfieldBackground.jsx';
import InteractiveMap from '../components/InteractiveMap.jsx';
import MrCodeGuide from '../components/MrCodeGuide.jsx';
import '../styles/portfolio.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hub',
  description = "Emmanuel Rueda's Data Analytics & BI Portfolio",
} = Astro.props;

// Normalized path ("/project-lab/" -> "/project-lab") so map + guide know where we are
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Emmanuel Rueda</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="portfolio-container">
      <StarfieldBackground client:load />

      <button class="map-toggle" type="button" aria-controls="node-map" aria-expanded="false">
        <span aria-hidden="true">◎</span> Map
      </button>
      <div class="map-backdrop" hidden></div>

      <div class="portfolio-grid">
        <aside id="node-map" class="sidebar-left" aria-label="Node map">
          <InteractiveMap client:load currentPath={currentPath} />
        </aside>

        <main class="main-content">
          <slot />
        </main>

        <aside class="sidebar-right" aria-label="Mr Code guide">
          <MrCodeGuide client:load currentPath={currentPath} />
        </aside>
      </div>
    </div>

    <script>
      // Map drawer on tablet/mobile
      const toggle = document.querySelector<HTMLButtonElement>('.map-toggle')!;
      const map = document.getElementById('node-map')!;
      const backdrop = document.querySelector<HTMLDivElement>('.map-backdrop')!;

      function setOpen(open: boolean) {
        map.classList.toggle('open', open);
        backdrop.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
      }

      toggle.addEventListener('click', () => setOpen(!map.classList.contains('open')));
      backdrop.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      });
    </script>
  </body>
</html>
